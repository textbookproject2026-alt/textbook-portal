# Cloudflare Pages headers. Pages consumes this file and never serves it, so it
# is not a URL and needs no exemption from the apex redirect rule.

# version.txt is the portal's deploy marker. textbook-registry's portal.yml polls
# it after firing the deploy hook and fails red if it doesn't reach the merge SHA
# within ten minutes. An edge-cached copy would report the previous build and the
# check would fail for the wrong reason.
/version.txt
  Cache-Control: no-store

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
